# ── ZooKeeper ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values before deploying on Railway.

# ZooKeeper server ID — keep as 1 for single-node deployment
ZOO_SERVER_ID=1

# Allow unauthenticated connections (fine for private Railway network)
ALLOW_ANONYMOUS_LOGIN=yes

# Auto-purge old snapshots every N hours (0 = disabled)
ZOO_AUTOPURGE_INTERVAL=1

# Expose Prometheus metrics on port 9141
ZOO_ENABLE_PROMETHEUS_METRICS=yes
ZOO_PROMETHEUS_METRICS_PORT_NUMBER=9141
