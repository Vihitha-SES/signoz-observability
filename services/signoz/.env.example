# ── SigNoz Backend + Frontend ─────────────────────────────────────────────────
# Copy this file to .env and fill in the values before deploying on Railway.
# All these can be set directly as Railway environment variables too.

# ── Required ──────────────────────────────────────────────────────────────────

# Public URL Railway gives to THIS signoz service (found in Railway service settings)
# Maps to config key global.external_url
SIGNOZ_GLOBAL_EXTERNAL_URL=https://signoz-production-xxxx.up.railway.app

# DSN pointing at your ClickHouse service
# On Railway internal network: tcp://clickhouse.railway.internal:9000
SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN=tcp://clickhouse.railway.internal:9000

# Secret for JWT token signing — change this to a strong random string!
SIGNOZ_TOKENIZER_JWT_SECRET=change-me-to-a-strong-random-secret

# ── Optional ──────────────────────────────────────────────────────────────────

# Port to listen on — Railway injects PORT automatically; leave blank normally.
# PORT=8080

# Override the full listen address (takes precedence over PORT)
# HTTP_HOST_PORT=0.0.0.0:8080

# SQLite DB path (default is fine, backed by Railway volume)
SIGNOZ_SQLSTORE_SQLITE_PATH=/var/lib/signoz/signoz.db

# Log level: debug | info | warn | error
SIGNOZ_INSTRUMENTATION_LOGS_LEVEL=info

# Alertmanager external URL (usually same as SIGNOZ_GLOBAL_EXTERNAL_URL)
SIGNOZ_ALERTMANAGER_SIGNOZ_EXTERNAL_URL=https://signoz-production-xxxx.up.railway.app
