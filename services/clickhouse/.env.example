# ── ClickHouse ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before deploying on Railway.

# ── Required ──────────────────────────────────────────────────────────────────

# ZooKeeper host (Railway internal network or public hostname)
# On Railway private network: zookeeper.railway.internal
ZOOKEEPER_HOST=zookeeper.railway.internal
ZOOKEEPER_PORT=2181

# ClickHouse's own hostname as seen by other replicas (used in cluster.xml)
# Usually the Railway private network hostname for this service
CLICKHOUSE_HOST=clickhouse.railway.internal
CLICKHOUSE_PORT=9000

# ── Optional ──────────────────────────────────────────────────────────────────
CLICKHOUSE_SKIP_USER_SETUP=1
