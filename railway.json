{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/signoz/Dockerfile"
  },
  "deploy": {
    "startCommand": "./signoz server --config /etc/signoz/config.yaml",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
